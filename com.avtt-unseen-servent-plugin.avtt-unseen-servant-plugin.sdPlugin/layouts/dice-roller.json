{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/layout.json",
  "id": "dice-roller",
  "items": [
    {
      "key": "icon",
      "type": "pixmap",
      "rect": [8, 22, 56, 56]
    },
    {
      "key": "title",
      "type": "text",
      "rect": [72, 8, 122, 20],
      "font": { "size": 14, "weight": 500 },
      "color": "#a0a0a0",
