    },
    {
      "key": "value",
      "type": "text",
      "rect": [72, 30, 122, 40],
      "font": { "size": 22, "weight": 700 },
      "alignment": "left"
    },
    {
      "key": "hint",
      "type": "text",
      "rect": [72, 74, 122, 18],
      "font": { "size": 12, "weight": 400 },
      "color": "#808080",
      "alignment": "left"
    }
  ]
}
